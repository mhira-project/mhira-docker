#!/bin/sh
#
# Deletes backups older than 30 days, except the newest complete ones
# (present and not empty in both folders), which are kept whatever their
# age. A broken backup can therefore never leave the installation with no
# usable backup, and a full backup disk still gets space back every night,
# so the backups can resume on their own.

set -u

postgres_dir=/backups/postgres
mongo_dir=/backups/mongo
keep_newest=3

log() {
    echo "$(date '+%Y-%m-%dT%T') $*"
}

log "Running mhira backups prune..."

status=0
if ! problem=$(/bin/healthcheck); then
    log "ERROR: ${problem}. Check the backup." \
        "The newest ${keep_newest} complete backups are kept whatever their age."
    status=1
fi

# The file names carry the timestamp, so sorting by name sorts by age.
kept=""
count=0
for name in $(cd "$postgres_dir" 2>/dev/null && ls -r mhira-data-*.dump 2>/dev/null); do
    [ "$count" -lt "$keep_newest" ] || break
    if [ -s "${postgres_dir}/${name}" ] && [ -s "${mongo_dir}/${name}" ]; then
        kept="${kept} ${name}"
        count=$((count+1))
    fi
done

deleted=0
for path in $(find "$postgres_dir" "$mongo_dir" -type f -mtime +30 2>/dev/null); do
    case " ${kept} " in
        *" $(basename "$path") "*) continue ;;
    esac
    rm -f "$path" && deleted=$((deleted+1))
done

log "Finished mhira backups prune: ${deleted} files deleted"
exit "$status"
